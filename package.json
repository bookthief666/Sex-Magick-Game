{
  "name": "sex-magick-cross-screen-qa",
  "private": true,
  "version": "0.0.0",
  "description": "Cross-screen and real-device QA tooling for the existing static game.",
  "scripts": {
    "serve:test": "http-server . -a 127.0.0.1 -p 8099 -c-1",
    "test:cross-screen": "playwright test --config=playwright.config.ts",
    "test:cross-screen:update": "playwright test --config=playwright.config.ts --update-snapshots",
    "test:browserstack-config": "node tools/test-browserstack-sdk-config.mjs",
    "test:supply-chain": "node tools/test-qa-supply-chain.mjs",
    "test:browserstack": "node tools/browserstack-real-device-smoke.mjs",
    "test:browserstack-mobile": "browserstack-node-sdk playwright test --config=playwright.browserstack.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "browserstack-node-sdk": "1.65.3",
    "http-server": "14.1.1"
  }
}
